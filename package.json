{
  "name": "onlinetoolbox",
  "version": "1.0.0",
  "description": "在线工具箱 - 157 个常用编解码、文本处理、格式化、生成器等开发者工具",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-pages.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "build:app": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run readme:check && npm run test:coverage && npm run build",
    "verify:build": "node scripts/verify-build.mjs",
    "readme": "node scripts/sync-readme.mjs",
    "readme:check": "node scripts/sync-readme.mjs --check",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.11",
    "exifr": "^7.1.3",
    "gpt-tokenizer": "^4.0.0",
    "js-yaml": "^4.2.0",
    "jsbarcode": "^3.12.3",
    "marked": "^18.0.5",
    "otpauth": "^9.5.1",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.8.0",
    "ulid": "^3.0.2"
  },
  "homepage": "https://tools.xiaoxura.com/"
}
